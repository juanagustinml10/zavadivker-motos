# Puerto del servidor (solo local; Vercel Functions no lo usa)
PORT=4000

# URL pública del backend. En producción: https://<proyecto-backend>.vercel.app
# Obligatoria y HTTPS (nunca localhost) cuando STORAGE_DRIVER=db: se usa para
# guardar BikeImage.url como https://<backend>/api/images/<clave>.
PUBLIC_BASE_URL=http://localhost:4000

# Conexión a PostgreSQL (Neon).
# Pooled (hostname con `-pooler`): la usa la app en runtime (DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"

# Conexión directa (hostname SIN `-pooler`): obligatoria para `prisma migrate deploy`
# porque schema.prisma declara directUrl. `prisma generate` no necesita conectarse.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Secretos JWT — valores aleatorios distintos, nunca commitear los reales
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso_en_produccion
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_en_produccion

# Duración de los tokens (segundos)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Orígenes permitidos para CORS, separados por coma. Admite patrones con * (ej. https://*.pages.dev).
# Obligatorio en producción; el comodín suelto (*) está prohibido. Ejemplo:
# https://<proyecto>.pages.dev,https://<dominio-custom>
CORS_ORIGIN=http://localhost:5173

# Fotografías:
# - "local": desarrollo; archivos en UPLOAD_DIR servidos por express.static().
# - "db": recomendado en Vercel; bytes en Neon (BYTEA) servidos por /api/images/:key.
#   No requiere ninguna variable S3; sí PUBLIC_BASE_URL HTTPS público.
# - "s3": driver anterior; obliga todas las variables STORAGE_* / AWS_* de abajo.
STORAGE_DRIVER=local
STORAGE_S3_BUCKET=
STORAGE_PUBLIC_BASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Carpeta local de subidas (solo STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads

# Tamaño máximo por imagen. 4 MB deja margen bajo el límite de body de Vercel.
MAX_FILE_SIZE=4194304

# Usuario administrador semillado solo si no existe (NO ejecutar en cada deploy)
SEED_ADMIN_EMAIL=admin@zavadivker.invalid
SEED_ADMIN_PASSWORD=cambiar_esta_contraseña_en_produccion
